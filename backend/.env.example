# Copia este archivo como .env y completa tus valores.
# Nunca subas este archivo con credenciales reales a GitHub.

# Cadena de conexión de Neon (consígela en Neon > Settings > Connection string)
DATABASE_URL=postgresql://usuario:password@host:puerto/base_de_datos?sslmode=require

# Genera un secreto aleatorio largo (mínimo 32 caracteres).
JWT_SECRET=tu_secreto_aqui_minimo_32_caracteres
JWT_EXPIRES_IN=8h

# Se usan una sola vez al crear el administrador inicial.
ADMIN_NAME=Administrador AquaChile
ADMIN_EMAIL=administrador@aquachile.cl
ADMIN_PASSWORD=AdminAquaChile2026!

PORT=4000

# Google Drive OAuth (solo backend; nunca usar variables VITE_*).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Se guarda automáticamente al ejecutar: npm run autorizar-drive
GOOGLE_OAUTH_REFRESH_TOKEN=
# ID de la carpeta raíz AquaChile (los CV se organizan en subcarpetas por candidato).
GOOGLE_DRIVE_FOLDER_AQUACHILE_ID=
# ID de carpeta Reportes.
GOOGLE_DRIVE_FOLDER_REPORTES_ID=
